# npm/pnpm registry — use npmmirror (Taobao/Alibaba) for faster downloads in China
registry=https://registry.npmmirror.com/

# better-sqlite3 prebuilt binary mirror (avoids compiling from source when possible)
better_sqlite3_binary_host_mirror=https://registry.npmmirror.com/-/binary/better-sqlite3

# node-gyp binary mirror for node headers
disturl=https://npmmirror.com/mirrors/node
